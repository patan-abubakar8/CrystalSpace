@model IEnumerable<Organize4u.Core.Models.Salary>

<div class="hr-card">
    <h5 class="mb-4" style="font-weight: 700;"><i class="fas fa-dollar-sign me-2 text-accent-green"></i> Salary History</h5>
    
    @if (!Model.Any())
    {
        <div class="text-center text-secondary py-4">
            <i class="fas fa-coins mb-3" style="font-size: 48px; opacity: 0.3;"></i>
            <p>No salary records found</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-premium">
                <thead>
                    <tr>
                        <th>Effective Date</th>
                        <th>Base Salary</th>
                        <th>Allowance</th>
                        <th>Bonus</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var salary in Model.OrderByDescending(s => s.LastUpdate))
                    {
                        var total = salary.BaseSalary + salary.Allowance + salary.Bonus;
                        
                        <tr>
                            <td>@salary.LastUpdate.ToString("MMM dd, yyyy")</td>
                            <td>@salary.BaseSalary.ToString("C")</td>
                            <td>@salary.Allowance.ToString("C")</td>
                            <td>@salary.Bonus.ToString("C")</td>
                            <td style="font-weight: 700; color: var(--accent-green);">@total.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
