@model IEnumerable<Organize4u.Core.Models.Leave>

<div class="hr-card">
    <h5 class="mb-4" style="font-weight: 700;"><i class="fas fa-calendar-alt me-2 text-accent-green"></i> Leave History</h5>
    
    @if (!Model.Any())
    {
        <div class="text-center text-secondary py-4">
            <i class="fas fa-calendar-check mb-3" style="font-size: 48px; opacity: 0.3;"></i>
            <p>No leave records found</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-premium">
                <thead>
                    <tr>
                        <th>Leave Type</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Duration</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th>Applied On</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var leave in Model)
                    {
                        var statusClass = leave.Status switch
                        {
                            Organize4u.Core.Models.LeaveStatus.Approved => "bg-success",
                            Organize4u.Core.Models.LeaveStatus.Rejected => "bg-danger",
                            _ => "bg-warning"
                        };
                        
                        var duration = (leave.EndDate - leave.StartDate).Days + 1;
                        
                        <tr>
                            <td>
                                <span class="badge bg-secondary">@leave.LeaveType?.Name</span>
                            </td>
                            <td>@leave.StartDate.ToString("MMM dd, yyyy")</td>
                            <td>@leave.EndDate.ToString("MMM dd, yyyy")</td>
                            <td>@duration days</td>
                            <td>@(leave.Reason ?? "-")</td>
                            <td>
                                <span class="badge @statusClass">@leave.Status</span>
                            </td>
                            <td>@leave.AppliedOn.ToString("MMM dd, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
