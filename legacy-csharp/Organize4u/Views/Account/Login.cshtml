@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Organize4u</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-main: #f4f7f5;
            --bg-card: #ffffff;
            --accent-green: #00c853;
            --accent-green-hover: #009624;
            --accent-green-light: #e8f5e9;
            --text-main: #1a2e1c;
            --text-muted: #5f7a62;
            --input-bg: #ffffff;
            --border-color: #d8e8da;
        }

        body, html {
            height: 100%;
            margin: 0;
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-main);
            color: var(--text-main);
            overflow: hidden;
        }

        .login-wrapper {
            display: flex;
            height: 100vh;
            width: 100%;
        }

        /* Left Side: Branding */
        .branding-side {
            flex: 1.2;
            background: linear-gradient(135deg, #e8f5e9 0%, #f4f7f5 100%);
            padding: 80px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
            background-image:
                radial-gradient(circle at 2px 2px, rgba(0,180,80,0.06) 1px, transparent 0);
            background-size: 32px 32px;
        }

        .logo-box {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 60px;
        }

        .logo-icon {
            width: 44px;
            height: 44px;
            background: var(--accent-green);
            clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .logo-text {
            font-size: 28px;
            font-weight: 800;
            letter-spacing: -0.02em;
            color: var(--text-primary);
        }

        .branding-content h1 {
            font-size: 48px;
            font-weight: 800;
            margin-bottom: 24px;
            letter-spacing: -0.03em;
            color: var(--text-primary);
        }

        .branding-content p {
            font-size: 18px;
            color: var(--text-secondary);
            max-width: 500px;
            line-height: 1.6;
            margin-bottom: 48px;
        }

        .branding-image {
            width: 100%;
            max-width: 600px;
            border-radius: 20px;
            box-shadow: 0 20px 50px rgba(0, 100, 40, 0.12);
            border: 1px solid rgba(0,180,80,0.15);
        }

        /* Right Side: Form */
        .form-side {
            flex: 1;
            background-color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px;
            border-left: 1px solid var(--border-color);
        }

        .form-container {
            width: 100%;
            max-width: 400px;
        }

        .form-header h2 {
            font-size: 32px;
            font-weight: 800;
            margin-bottom: 12px;
            color: var(--text-primary);
        }

        .form-header p {
            color: var(--text-secondary);
            margin-bottom: 40px;
        }

        .form-group {
            margin-bottom: 24px;
        }

        .form-label {
            display: block;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 10px;
            color: var(--text-primary);
        }

        .input-wrapper {
            position: relative;
        }

        .input-wrapper i {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-secondary);
        }

        .form-control {
            width: 100%;
            background-color: var(--input-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 16px 16px 16px 52px;
            color: var(--text-main);
            font-size: 15px;
            transition: all 0.3s;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--accent-green);
            background-color: #f0fbf4;
            box-shadow: 0 0 0 4px rgba(0, 200, 83, 0.12);
        }

        .forgot-link {
            float: right;
            color: var(--accent-green);
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
        }

        .remember-me {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--text-muted);
            font-size: 14px;
            cursor: pointer;
            margin-bottom: 32px;
        }

        .remember-me input {
            accent-color: var(--accent-green);
            width: 18px;
            height: 18px;
        }

        .btn-signin {
            width: 100%;
            background-color: var(--accent-green);
            color: #fff;
            border: none;
            border-radius: 12px;
            padding: 16px;
            font-weight: 800;
            font-size: 16px;
            cursor: pointer;
            transition: all 0.3s;
            margin-bottom: 40px;
        }

        .btn-signin:hover {
            background-color: var(--accent-green-hover);
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(0, 150, 36, 0.25);
        }

        .footer-text {
            color: var(--text-muted);
            font-size: 12px;
            text-align: center;
            line-height: 1.5;
        }

        .text-danger ul {
            list-style: none;
            padding: 15px;
            background: rgba(229, 57, 53, 0.08);
            border-radius: 12px;
            color: #c62828;
            font-size: 14px;
            margin-bottom: 24px;
        }
    </style>
</head>
<body>
    <div class="login-wrapper">
        <!-- Branding Side -->
        <div class="branding-side">
            <div class="logo-box">
                <div class="logo-icon"></div>
                <div class="logo-text">Organize4U</div>
            </div>
            
            <div class="branding-content">
                <h1>All in one Workspace</h1>
                <p>Access your employee records, payroll, and performance metrics in one secure, unified platform.</p>
                <img src="/brain/aadee13a-5c95-411d-8d65-1c478b68f59b/login_desk_image_1773297769454.png" alt="Workspace" class="branding-image">
            </div>
        </div>

        <!-- Form Side -->
        <div class="form-side">
            <div class="form-container">
                <div class="form-header">
                    <h2>Welcome Back</h2>
                    <p>Please enter your credentials to access your account.</p>
                </div>

                <form asp-action="Login" asp-controller="Account" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    <div asp-validation-summary="All" class="text-danger"></div>

                    <div class="form-group">
                        <label class="form-label">Email or Username</label>
                        <div class="input-wrapper">
                            <i class="fas fa-user"></i>
                            <input type="email" name="email" class="form-control" placeholder="name@@company.com" required autofocus>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            Password
                            <a href="#" class="forgot-link">Forgot password?</a>
                        </label>
                        <div class="input-wrapper">
                            <i class="fas fa-lock"></i>
                            <input type="password" name="password" class="form-control" placeholder="••••••••" required>
                        </div>
                    </div>

                    <label class="remember-me">
                        <input type="checkbox" name="rememberMe" value="true">
                        <span>Remember this device</span>
                    </label>

                    <button type="submit" class="btn-signin">Sign In</button>
                    
                    <div class="footer-text">
                        © 2024 Organize4U Inc. All rights reserved. Secure encrypted connection.
                    </div>
                </form>
            </div>
        </div>
    </div>
        
        <p class="text-center mt-4" style="color: var(--text-muted); font-size: 0.875rem;">
            &copy; 2026 Organize4u. All rights reserved.
        </p>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
