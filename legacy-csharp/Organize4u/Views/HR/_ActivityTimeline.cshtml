@model IEnumerable<Organize4u.Core.Models.ActivityLog>

<div class="hr-card">
    <h5 class="mb-4" style="font-weight: 700;"><i class="fas fa-history me-2 text-accent-green"></i> Activity Timeline</h5>
    
    @if (!Model.Any())
    {
        <div class="text-center text-secondary py-4">
            <i class="fas fa-clock mb-3" style="font-size: 48px; opacity: 0.3;"></i>
            <p>No recent activity</p>
        </div>
    }
    else
    {
        <div class="timeline-container">
            @foreach (var activity in Model)
            {
                <div class="timeline-item mb-3">
                    <div class="d-flex gap-3">
                        <div class="timeline-icon" style="width: 40px; height: 40px; border-radius: 50%; background: rgba(0, 200, 150, 0.1); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                            <i class="fas fa-check-circle" style="color: var(--accent-green);"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="text-white fw-bold">@activity.Action</div>
                            <div class="small text-secondary">@activity.Details</div>
                            <div class="x-small text-secondary mt-1">@activity.Timestamp.ToString("MMM dd, yyyy HH:mm")</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .timeline-container {
        position: relative;
        padding-left: 20px;
    }
    .timeline-container::before {
        content: '';
        position: absolute;
        left: 19px;
        top: 0;
        bottom: 0;
        width: 2px;
        background: rgba(255,255,255,0.1);
    }
</style>
