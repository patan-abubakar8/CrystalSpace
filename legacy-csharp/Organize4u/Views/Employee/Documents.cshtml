@model IEnumerable<Organize4u.Core.Models.EmployeeDocument>

@{
    ViewData["Title"] = "Documents";
    Layout = "_EmployeeLayout";
}

<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h1 style="font-weight: 800; font-size: 32px; letter-spacing: -1px;">My Documents</h1>
        <p class="text-secondary">Access your HR documents, contracts, and certificates.</p>
    </div>
    <div class="d-flex gap-2">
        <div class="input-group" style="width: 250px;">
            <span class="input-group-text bg-white border-end-0" style="border-radius: 12px 0 0 12px;">
                <i class="fas fa-search text-secondary"></i>
            </span>
            <input type="text" class="form-control border-start-0" placeholder="Search..." style="border-radius: 0 12px 12px 0; background: white;">
        </div>
        <button class="btn btn-premium">
            <i class="fas fa-upload me-2"></i> Upload Personal
        </button>
    </div>
</div>

<div class="row g-4 mb-5">
    <!-- Category Folders -->
    <div class="col-md-3">
        <div class="ess-card text-center p-4 h-100 folder-card active">
            <i class="fas fa-folder fa-3x text-premium mb-3"></i>
            <h6 class="fw-700 mb-1">Company Policies</h6>
            <p class="small text-secondary mb-0">12 Files</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="ess-card text-center p-4 h-100 folder-card">
            <i class="fas fa-folder fa-3x text-secondary mb-3 opacity-50"></i>
            <h6 class="fw-700 mb-1">Onboarding Docs</h6>
            <p class="small text-secondary mb-0">5 Files</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="ess-card text-center p-4 h-100 folder-card">
            <i class="fas fa-folder fa-3x text-secondary mb-3 opacity-50"></i>
            <h6 class="fw-700 mb-1">Certificates</h6>
            <p class="small text-secondary mb-0">3 Files</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="ess-card text-center p-4 h-100 folder-card">
            <i class="fas fa-folder fa-3x text-secondary mb-3 opacity-50"></i>
            <h6 class="fw-700 mb-1">Payslips</h6>
            <p class="small text-secondary mb-0">Record history</p>
        </div>
    </div>
</div>

<div class="ess-card p-0 overflow-hidden">
    <div class="p-4 border-bottom">
        <h5 class="mb-0 fw-700">All Files</h5>
    </div>
    <div class="table-responsive">
        <table class="table-ess mb-0">
            <thead>
                <tr>
                    <th class="ps-4">FILE NAME</th>
                    <th>CATEGORY</th>
                    <th>SIZE</th>
                    <th>UPLOAD DATE</th>
                    <th class="text-end pe-4">ACTION</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var doc in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <i class="fas @(doc.DocumentType.Contains("Pdf") ? "fa-file-pdf text-danger" : "fa-file-word text-primary") fa-lg"></i>
                                    <div>
                                        <div class="fw-600">@doc.DocumentType</div>
                                        <div class="small text-secondary">Original Filename.pdf</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge bg-light text-dark">@doc.DocumentType</span></td>
                            <td class="text-secondary">@doc.FileSize KB</td>
                            <td class="text-secondary">@doc.UploadDate.ToString("MMM dd, yyyy")</td>
                            <td class="text-end pe-4">
                                <button class="btn btn-light btn-sm"><i class="fas fa-download"></i></button>
                                <button class="btn btn-light btn-sm text-danger ms-1"><i class="fas fa-trash"></i></button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <!-- Mock Data -->
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center gap-3">
                                <i class="fas fa-file-pdf text-danger fa-lg"></i>
                                <div>
                                    <div class="fw-600">Offer Letter - Organise4U</div>
                                    <div class="small text-secondary">Offer_Letter_2023.pdf</div>
                                </div>
                            </div>
                        </td>
                        <td><span class="badge bg-light text-dark">Onboarding Docs</span></td>
                        <td class="text-secondary">2.4 MB</td>
                        <td class="text-secondary">Jan 01, 2023</td>
                        <td class="text-end pe-4">
                            <button class="btn btn-light btn-sm"><i class="fas fa-download"></i></button>
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center gap-3">
                                <i class="fas fa-file-pdf text-danger fa-lg"></i>
                                <div>
                                    <div class="fw-600">Employee Hand Book v2</div>
                                    <div class="small text-secondary">Handbook_2023.pdf</div>
                                </div>
                            </div>
                        </td>
                        <td><span class="badge bg-light text-dark">Company Policies</span></td>
                        <td class="text-secondary">4.8 MB</td>
                        <td class="text-secondary">Feb 15, 2023</td>
                        <td class="text-end pe-4">
                            <button class="btn btn-light btn-sm"><i class="fas fa-download"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .folder-card {
        cursor: pointer;
        transition: transform 0.2s, border-color 0.2s;
    }
    .folder-card:hover {
        transform: translateY(-5px);
        border-color: var(--ess-accent);
    }
    .folder-card.active {
        border-color: var(--ess-accent);
        background: #ecfdf5;
    }
</style>
