@model Organize4u.Core.Models.Employee
@inject Organize4u.Core.Interfaces.IHRService _hrService

@{
    ViewData["Title"] = "Employee Profile";
    Layout = "_HRLayout";
}

<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h1 class="h2 mb-1" style="font-weight: 800;">Employee Profile</h1>
        <div class="hr-search-bar py-1 px-3 mt-2" style="width: 300px;">
            <i class="fas fa-search text-secondary small"></i>
            <input type="text" class="hr-search-input small" placeholder="Search employees...">
        </div>
    </div>
    <div class="d-flex align-items-center gap-3">
        <div class="stat-icon" style="background: rgba(255,255,255,0.05); cursor: pointer;"><i class="fas fa-bell"></i></div>
        <div class="stat-icon" style="background: rgba(255,255,255,0.05); cursor: pointer;"><i class="fas fa-user-circle"></i></div>
    </div>
</div>

<div class="hr-card mb-4">
    <div class="row align-items-center">
        <div class="col-auto">
            <img src="https://ui-avatars.com/api/?name=@Model.FirstName+@Model.LastName&size=120&background=0D8ABC&color=fff" class="rounded-circle" style="width: 120px; border: 4px solid var(--border-color);" alt="">
        </div>
        <div class="col">
            <h2 class="mb-1" style="font-weight: 800;">@Model.FirstName @Model.LastName</h2>
            <p class="mb-2" style="color: var(--accent-green); font-weight: 600;">@Model.Designation</p>
            <div class="d-flex gap-4 text-secondary small">
                <span><i class="fas fa-id-badge me-1"></i> @(Model.EmployeeCode ?? "EMP-" + Model.Id)</span>
                <span><i class="fas fa-map-marker-alt me-1"></i> @(Model.PersonalDetail?.City ?? "Not Set"), @(Model.PersonalDetail?.Country ?? "")</span>
                <span><i class="fas fa-building me-1"></i> @(Model.OfficeLocation ?? "Headquarters")</span>
                <span><i class="fas fa-envelope me-1"></i> @Model.Email</span>
            </div>
        </div>
        <div class="col-auto">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-premium me-2">
                <i class="fas fa-edit me-2"></i> Edit Profile
            </a>
            <button class="btn btn-premium">
                <i class="fas fa-paper-plane me-2"></i> Message
            </button>
        </div>
    </div>
</div>

<div class="hr-tabs">
    <div class="hr-tab-item active" onclick="showTab('profile')">Profile Info</div>
    <div class="hr-tab-item" onclick="showTab('employment')">Employment Details</div>
    <div class="hr-tab-item" onclick="showTab('leaves')">Leave History</div>
    <div class="hr-tab-item" onclick="showTab('salary')">Salary History</div>
    <div class="hr-tab-item" onclick="showTab('documents')">Documents</div>
    <div class="hr-tab-item" onclick="showTab('activity')">Activity Timeline</div>
</div>

<!-- Profile Info Tab -->
<div id="profile-tab" class="tab-content">
    <div class="row">
        <!-- Left Column -->
        <div class="col-lg-8">
            @await Html.PartialAsync("_OtherDetails", Model)
            
            <div class="hr-card mb-4">
                <h5 class="mb-4" style="font-weight: 700;"><i class="fas fa-user-edit me-2 text-accent-green"></i> Personal Information</h5>
                <div class="row row-cols-2 g-4">
                    <div>
                        <div class="text-secondary small mb-1">FULL NAME</div>
                        <div style="font-weight: 600;">@Model.FirstName @Model.LastName</div>
                    </div>
                    <div>
                        <div class="text-secondary small mb-1">DATE OF BIRTH</div>
                        <div style="font-weight: 600;">@(Model.PersonalDetail?.DateOfBirth.ToString("MMMM dd, yyyy") ?? "N/A")</div>
                    </div>
                    <div>
                        <div class="text-secondary small mb-1">GENDER</div>
                        <div style="font-weight: 600;">@(Model.PersonalDetail?.Gender ?? "N/A")</div>
                    </div>
                    <div>
                        <div class="text-secondary small mb-1">MOBILE NUMBER</div>
                        <div style="font-weight: 600;">@(Model.Phone ?? "N/A")</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column -->
        <div class="col-lg-4">
            <div class="hr-card performance-card mb-4" style="border: none;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div style="font-weight: 700;"><i class="fas fa-bolt me-2"></i> Performance Score</div>
                </div>
                <div class="d-flex align-items-baseline gap-2 mb-2">
                    <span style="font-size: 48px; font-weight: 800;">@(Model.ProfessionalDetail?.PerformanceScore.ToString("F1") ?? "0.0")</span>
                    <span class="small" style="opacity: 0.8;">/5.0</span>
                    @if ((Model.ProfessionalDetail?.PerformanceScore ?? 0) >= 4.5)
                    {
                        <span class="ms-auto badge bg-white text-dark small" style="font-weight: 700;">Top 5%</span>
                    }
                </div>
                <div class="small mb-3" style="opacity: 0.8;">Last Review: @(Model.ProfessionalDetail != null ? "Completed" : "Pending")</div>
                <div class="progress" style="height: 8px; background: rgba(0,0,0,0.1);">
                    @{
                        var scorePct = (Model.ProfessionalDetail?.PerformanceScore ?? 0) * 20;
                    }
                    <div class="progress-bar bg-white" style="width: @(scorePct)%"></div>
                </div>
            </div>

            <div class="hr-card mb-4">
                <h5 class="mb-4" style="font-weight: 700;">Skills & Expertise</h5>
                <div class="d-flex flex-wrap gap-2">
                    @if (!string.IsNullOrEmpty(Model.Skills))
                    {
                        foreach (var skill in Model.Skills.Split(','))
                        {
                            <span class="skill-tag">@skill.Trim()</span>
                        }
                    }
                    else
                    {
                        <span class="text-secondary small">No skills listed</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Employment Details Tab -->
<div id="employment-tab" class="tab-content" style="display: none;">
    @await Html.PartialAsync("_EmploymentDetails", Model)
</div>

<!-- Leave History Tab -->
<div id="leaves-tab" class="tab-content" style="display: none;">
    @{
        var leaves = await _hrService.GetEmployeeLeavesAsync(Model.Id);
    }
    @await Html.PartialAsync("_LeaveHistory", leaves)
</div>

<!-- Salary History Tab -->
<div id="salary-tab" class="tab-content" style="display: none;">
    @{
        var salaries = await _hrService.GetEmployeeSalariesAsync(Model.Id);
    }
    @await Html.PartialAsync("_SalaryHistory", salaries)
</div>

<!-- Documents Tab -->
<div id="documents-tab" class="tab-content" style="display: none;">
    @{
        var documents = await _hrService.GetEmployeeDocumentsAsync(Model.Id);
    }
    @await Html.PartialAsync("_Documents", documents)
</div>

<!-- Activity Timeline Tab -->
<div id="activity-tab" class="tab-content" style="display: none;">
    @{
        var activities = await _hrService.GetEmployeeActivitiesAsync(Model.Id);
    }
    @await Html.PartialAsync("_ActivityTimeline", activities)
</div>

@section Scripts {
    <script>
        function showTab(tabName) {
            // Hide all tabs
            document.querySelectorAll('.tab-content').forEach(tab => {
                tab.style.display = 'none';
            });
            
            // Remove active class from all tab items
            document.querySelectorAll('.hr-tab-item').forEach(item => {
                item.classList.remove('active');
            });
            
            // Show selected tab
            document.getElementById(tabName + '-tab').style.display = 'block';
            
            // Add active class to clicked tab item
            event.target.classList.add('active');
        }
    </script>
}
