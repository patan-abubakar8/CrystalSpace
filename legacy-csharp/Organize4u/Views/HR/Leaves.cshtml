@model IEnumerable<Organize4u.Core.Models.Leave>

@{
    ViewData["Title"] = "Leave Management";
    Layout = "_HRLayout";
}

<style>
    .leave-tabs .nav-link {
        color: var(--text-secondary);
        border: none;
        padding: 10px 0;
        margin-right: 30px;
        font-weight: 600;
        background: none;
        position: relative;
    }
    .leave-tabs .nav-link.active {
        color: var(--accent-green);
    }
    .leave-tabs .nav-link.active::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 3px;
        background: var(--accent-green);
        border-radius: 3px;
    }
    
    .policy-card {
        background: rgba(0, 200, 150, 0.05);
        border: 1px solid rgba(0, 200, 150, 0.1);
        border-radius: 12px;
        padding: 24px;
    }
    .policy-item {
        display: flex;
        gap: 12px;
        margin-bottom: 20px;
    }
    .policy-item i { color: var(--accent-green); margin-top: 4px; }
    
    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 1px;
        background: var(--border-color);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        overflow: hidden;
    }
    .calendar-day {
        background: var(--card-bg);
        padding: 15px;
        min-height: 100px;
        transition: all 0.2s;
    }
    .calendar-day.header {
        background: rgba(255,255,255,0.03);
        min-height: auto;
        padding: 10px;
        text-align: center;
        font-weight: 600;
        color: var(--text-secondary);
        font-size: 12px;
    }
    .calendar-day.other-month { opacity: 0.3; }
    .calendar-day.active { background: rgba(0, 200, 150, 0.05); }
    
    .leave-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 8px;
    }
    
    .avatar-sm {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        object-fit: cover;
    }
    
    .status-badge {
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1" style="font-weight: 800;">Leave Management</h1>
        <p class="text-secondary mb-0">Review employee time-off requests, monitor department availability, and update organizational policies.</p>
    </div>
    <button class="btn btn-premium px-4">
        <i class="fas fa-plus-circle me-2"></i>New Leave Request
    </button>
</div>

<!-- Tabs -->
<ul class="nav leave-tabs mb-5">
    <li class="nav-item"><button class="nav-link active">Pending Requests (4)</button></li>
    <li class="nav-item"><button class="nav-link">Calendar View</button></li>
    <li class="nav-item"><button class="nav-link">Leave Policies</button></li>
</ul>

<div class="row">
    <!-- Main Content -->
    <div class="col-lg-8">
        <!-- Pending Requests Table -->
        <div class="hr-card p-0 mb-5 overflow-hidden">
            <table class="table table-dark table-hover mb-0" style="--bs-table-bg: transparent;">
                <thead>
                    <tr style="border-bottom: 1px solid var(--border-color);">
                        <th class="ps-4 py-3 text-secondary x-small">EMPLOYEE</th>
                        <th class="py-3 text-secondary x-small">LEAVE TYPE</th>
                        <th class="py-3 text-secondary x-small">DATES</th>
                        <th class="pe-4 py-3 text-secondary x-small text-end">ACTION</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var leave in Model)
                    {
                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                            <td class="ps-4 py-4">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="https://ui-avatars.com/api/?name=@(leave.Employee?.FirstName)+@(leave.Employee?.LastName)&background=00c896&color=fff" class="avatar-sm" />
                                    <div>
                                        <div class="text-white fw-bold">@(leave.Employee?.FirstName) @(leave.Employee?.LastName)</div>
                                        <div class="x-small text-secondary">@(leave.Employee?.Designation)</div>
                                    </div>
                                </div>
                            </td>
                            <td class="py-4">
                                @{
                                    var color = leave.LeaveType?.Name switch {
                                        "Annual Leave" => "#4a90e2",
                                        "Sick Leave" => "#ff7e00",
                                        "Personal Leave" => "#9013fe",
                                        _ => "#4a4a4a"
                                    };
                                }
                                <span class="status-badge" style="background: @(color)1a; color: @(color); border: 1px solid @(color)33;">
                                    @leave.LeaveType?.Name
                                </span>
                            </td>
                            <td class="py-4">
                                <div class="text-white">@leave.StartDate.ToString("MMM dd") - @leave.EndDate.ToString("MMM dd")</div>
                                <div class="x-small text-secondary">(@((leave.EndDate - leave.StartDate).Days + 1) days)</div>
                            </td>
                            <td class="pe-4 py-4 text-end">
                                <button type="button" class="btn btn-premium-success btn-sm me-2 btn-approve" data-id="@leave.Id"><i class="fas fa-check"></i></button>
                                <button type="button" class="btn btn-premium-danger btn-sm btn-reject" data-id="@leave.Id"><i class="fas fa-times"></i></button>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-secondary">No pending requests found</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Calendar Preview -->
        <h5 class="text-white mb-4 fw-bold">Calendar Overview - October</h5>
        <div class="calendar-grid mb-5">
            <div class="calendar-day header">SUN</div>
            <div class="calendar-day header">MON</div>
            <div class="calendar-day header">TUE</div>
            <div class="calendar-day header">WED</div>
            <div class="calendar-day header">THU</div>
            <div class="calendar-day header">FRI</div>
            <div class="calendar-day header">SAT</div>
            
            @for (int i = 27; i <= 31; i++) { <div class="calendar-day other-month">@i</div> }
            @for (int i = 1; i <= 11; i++) { <div class="calendar-day">@i</div> }
            <div class="calendar-day active" style="background: rgba(74, 144, 226, 0.15);">
                <span class="text-white">12</span>
                <div class="mt-2"><span class="leave-dot" style="background: #4a90e2;"></span></div>
            </div>
            <div class="calendar-day active" style="background: rgba(74, 144, 226, 0.15);">
                <span class="text-white">13</span>
                <div class="mt-2"><span class="leave-dot" style="background: #4a90e2;"></span></div>
            </div>
            <div class="calendar-day active" style="background: rgba(255, 126, 0, 0.15);">
                <span class="text-white">14</span>
                <div class="mt-2"><span class="leave-dot" style="background: #ff7e00;"></span></div>
            </div>
            <div class="calendar-day active" style="background: rgba(74, 144, 226, 0.15);">
                <span class="text-white">15</span>
                <div class="mt-2"><span class="leave-dot" style="background: #4a90e2;"></span></div>
            </div>
            @for (int i = 16; i <= 17; i++) { <div class="calendar-day">@i</div> }
        </div>
    </div>

    <!-- Sidebar -->
    <div class="col-lg-4">
        <!-- Quick Policies -->
        <div class="policy-card mb-4 text-secondary">
            <h6 class="text-white fw-bold mb-4 d-flex align-items-center gap-2">
                <i class="fas fa-shield-alt" style="font-size: 14px; color: var(--accent-green);"></i> Quick Policies
            </h6>
            <div class="policy-item">
                <i class="fas fa-clock"></i>
                <div>
                    <div class="text-white small fw-bold">NOTICE PERIOD</div>
                    <div class="x-small">At least 2 weeks notice is required for annual leave requests over 3 days.</div>
                </div>
            </div>
            <div class="policy-item">
                <i class="fas fa-calendar-times" style="color: #ff4d4d;"></i>
                <div>
                    <div class="text-white small fw-bold">BLACKOUT DATES</div>
                    <div class="x-small">Nov 15 - Jan 5 are blackout dates for the Engineering department.</div>
                </div>
            </div>
            <div class="policy-item">
                <i class="fas fa-notes-medical"></i>
                <div>
                    <div class="text-white small fw-bold">SICK LEAVE</div>
                    <div class="x-small">Medical certificates are mandatory for sick leaves longer than 2 consecutive days.</div>
                </div>
            </div>
            <button class="btn btn-outline-premium w-100 mt-2 py-2 x-small">View Full Policy Manual</button>
        </div>

        <!-- Leave Legend -->
        <div class="hr-card mb-4">
            <h6 class="text-white fw-bold mb-4">LEAVE LEGEND</h6>
            <div class="d-flex flex-column gap-3">
                <div class="d-flex align-items-center text-secondary x-small">
                    <span class="leave-dot" style="background: #4a90e2;"></span> Annual Leave
                </div>
                <div class="d-flex align-items-center text-secondary x-small">
                    <span class="leave-dot" style="background: #ff7e00;"></span> Sick Leave
                </div>
                <div class="d-flex align-items-center text-secondary x-small">
                    <span class="leave-dot" style="background: #9013fe;"></span> Personal Leave
                </div>
                <div class="d-flex align-items-center text-secondary x-small">
                    <span class="leave-dot" style="background: #4a4a4a;"></span> Unpaid/Other
                </div>
            </div>
        </div>

        <!-- Today's Availability -->
        <div class="hr-card">
            <h6 class="text-white fw-bold mb-4">TODAY'S AVAILABILITY</h6>
            <div class="mb-4">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-secondary small">Engineering</span>
                    <span class="text-accent-green small fw-bold">92%</span>
                </div>
                <div class="progress" style="height: 6px; background: rgba(255,255,255,0.05); border-radius: 10px;">
                    <div class="progress-bar bg-accent-green" style="width: 92%;"></div>
                </div>
            </div>
            <div class="mb-2">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-secondary small">Design</span>
                    <span class="text-accent-green small fw-bold">75%</span>
                </div>
                <div class="progress" style="height: 6px; background: rgba(255,255,255,0.05); border-radius: 10px;">
                    <div class="progress-bar bg-accent-green" style="width: 75%;"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.btn-approve').click(function () {
                var btn = $(this);
                var id = btn.data('id');
                var row = btn.closest('tr');

                $.post('/HR/ApproveLeave', { id: id }, function () {
                    row.fadeOut(300, function () { $(this).remove(); });
                });
            });

            $('.btn-reject').click(function () {
                var btn = $(this);
                var id = btn.data('id');
                var row = btn.closest('tr');

                $.post('/HR/RejectLeave', { id: id }, function () {
                    row.fadeOut(300, function () { $(this).remove(); });
                });
            });
        });
    </script>
}
