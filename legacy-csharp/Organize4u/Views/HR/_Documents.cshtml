@model IEnumerable<Organize4u.Core.Models.EmployeeDocument>

<div class="hr-card">
    <h5 class="mb-4" style="font-weight: 700;"><i class="fas fa-folder-open me-2 text-accent-green"></i> Documents</h5>
    
    @if (!Model.Any())
    {
        <div class="text-center text-secondary py-4">
            <i class="fas fa-file-alt mb-3" style="font-size: 48px; opacity: 0.3;"></i>
            <p>No documents uploaded</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 g-3">
            @foreach (var doc in Model)
            {
                var iconClass = doc.DocumentType.ToLower() switch
                {
                    "pdf" => "fa-file-pdf",
                    "word" or "doc" => "fa-file-word",
                    "excel" or "xls" => "fa-file-excel",
                    "image" or "jpg" or "png" => "fa-file-image",
                    _ => "fa-file"
                };
                
                <div class="col">
                    <div class="d-flex align-items-center p-3" style="background: rgba(255,255,255,0.03); border-radius: 8px;">
                        <i class="fas @iconClass me-3" style="font-size: 24px; color: #ff4d4d;"></i>
                        <div class="flex-grow-1">
                            <div class="text-white fw-bold">@doc.DocumentName</div>
                            <div class="x-small text-secondary">@doc.DocumentType • Uploaded @doc.UploadDate.ToString("MMM dd, yyyy")</div>
                        </div>
                        <div class="d-flex gap-2">
                            <a href="@doc.FilePath" class="btn btn-sm btn-outline-premium" target="_blank">
                                <i class="fas fa-eye"></i>
                            </a>
                            <button class="btn btn-sm btn-outline-premium">
                                <i class="fas fa-download"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
