@model Organize4u.Core.Models.Employee

@{
    ViewData["Title"] = "My Profile";
    Layout = "_EmployeeLayout";
}

<div class="profile-banner-dark premium-shadow">
    <div class="position-relative">
        <img src="https://ui-avatars.com/api/?name=@Model.FirstName+@Model.LastName&background=6366f1&color=fff&size=100" class="profile-avatar-lg">
        <button class="btn btn-sm btn-success position-absolute bottom-0 end-0 rounded-circle p-0" style="width: 24px; height: 24px; border: 2px solid #0f172a;">
            <i class="fas fa-camera" style="font-size: 10px;"></i>
        </button>
    </div>
    <div class="flex-grow-1">
        <h2 class="mb-0 fw-800">@Model.FirstName @Model.LastName</h2>
        <div class="d-flex gap-3 opacity-75 small mt-1">
            <span><i class="fas fa-briefcase me-2"></i>@Model.Designation</span>
            <span><i class="fas fa-id-badge me-2"></i>@Model.EmployeeCode</span>
            <span><i class="fas fa-map-marker-alt me-2"></i>@Model.OfficeLocation</span>
        </div>
    </div>
    <button class="btn btn-accent px-4 fw-700" style="background: #10b981; color: white; border-radius: 12px; height: 44px;">
        <i class="fas fa-edit me-2"></i> Edit Profile
    </button>
</div>

<div class="ess-layout-grid">
    <!-- Left Column: Primary Info -->
    <div class="d-flex flex-column gap-4">
        <!-- Personal Information -->
        <div class="ess-card premium-shadow">
            <div class="d-flex align-items-center gap-2 mb-4">
                <i class="fas fa-user-circle text-accent" style="color: #10b981;"></i>
                <h6 class="mb-0 fw-800">Personal Information</h6>
            </div>
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="text-secondary small fw-700 mb-1">FIRST NAME</div>
                    <div class="fw-700">@Model.FirstName</div>
                </div>
                <div class="col-md-6">
                    <div class="text-secondary small fw-700 mb-1">LAST NAME</div>
                    <div class="fw-700">@Model.LastName</div>
                </div>
                <div class="col-md-6">
                    <div class="text-secondary small fw-700 mb-1">EMAIL ADDRESS</div>
                    <div class="fw-700">@Model.Email</div>
                </div>
                <div class="col-md-6">
                    <div class="text-secondary small fw-700 mb-1">PHONE NUMBER</div>
                    <div class="fw-700">@(Model.Phone ?? "+1 (555) 123-4567")</div>
                </div>
                <div class="col-md-6">
                    <div class="text-secondary small fw-700 mb-1">DATE OF BIRTH</div>
                    <div class="fw-700">@(Model.PersonalDetail?.DateOfBirth.ToString("MMM dd, yyyy") ?? "May 14, 1992")</div>
                </div>
                <div class="col-md-6">
                    <div class="text-secondary small fw-700 mb-1">GENDER</div>
                    <div class="fw-700">@(Model.PersonalDetail?.Gender ?? "Male")</div>
                </div>
            </div>
            <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-secondary small fw-700 mb-1">RESIDENTIAL ADDRESS</div>
                    <div class="fw-700"><i class="fas fa-home me-2 text-secondary"></i>@(Model.PersonalDetail?.Address ?? "123 Innovation Drive, Tech City, NY")</div>
                </div>
                <button class="btn btn-link text-accent fw-700 p-0 text-decoration-none" style="color: #10b981;">Edit</button>
            </div>
        </div>

        <!-- Employment Details -->
        <div class="ess-card premium-shadow">
            <div class="d-flex align-items-center gap-2 mb-4">
                <i class="fas fa-briefcase text-accent" style="color: #10b981;"></i>
                <h6 class="mb-0 fw-800">Employment Details</h6>
            </div>
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="text-secondary small fw-700 mb-1">EMPLOYEE ID</div>
                    <div class="fw-700">@Model.EmployeeCode</div>
                </div>
                <div class="col-md-6">
                    <div class="text-secondary small fw-700 mb-1">DEPARTMENT</div>
                    <div class="fw-700">@Model.Department?.Name</div>
                </div>
                <div class="col-md-6">
                    <div class="text-secondary small fw-700 mb-1">ROLE / DESIGNATION</div>
                    <div class="fw-700">@Model.Designation</div>
                </div>
                <div class="col-md-6">
                    <div class="text-secondary small fw-700 mb-1">DIRECT MANAGER</div>
                    <div class="fw-700">
                        @if (Model.Manager != null)
                        {
                            <img src="https://ui-avatars.com/api/?name=@Model.Manager.FirstName+@Model.Manager.LastName&size=20" class="rounded-circle me-1">
                            @Model.Manager.FirstName @Model.Manager.LastName
                        }
                        else
                        {
                            <span>Sarah Williams</span>
                        }
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="text-secondary small fw-700 mb-1">JOINING DATE</div>
                    <div class="fw-700">@Model.JoiningDate.ToString("MMMM dd, yyyy")</div>
                </div>
                <div class="col-md-6">
                    <div class="text-secondary small fw-700 mb-1">EMPLOYMENT TYPE</div>
                    <td><span class="pill-ess" style="background: #ecfdf5; color: #10b981;">@Model.EmploymentType</span></td>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Secondary Widgets -->
    <div class="d-flex flex-column gap-4">
        <!-- Skills -->
        <div class="ess-card premium-shadow">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="d-flex align-items-center gap-2">
                    <i class="fas fa-shield-alt text-accent" style="color: #10b981;"></i>
                    <h6 class="mb-0 fw-800">Skills & Expertise</h6>
                </div>
                <button class="btn btn-outline-success btn-sm border-0 rounded-circle"><i class="fas fa-plus"></i></button>
            </div>
            <div class="d-flex flex-wrap gap-2">
                @if (!string.IsNullOrEmpty(Model.Skills))
                {
                    foreach (var skill in Model.Skills.Split(','))
                    {
                        <span class="badge bg-light text-secondary border px-3 py-2" style="border-radius: 8px; font-weight: 600;">@skill.Trim()</span>
                    }
                }
                else
                {
                    <span class="badge bg-light text-secondary border px-3 py-2" style="border-radius: 8px; font-weight: 600;">React.js</span>
                    <span class="badge bg-light text-secondary border px-3 py-2" style="border-radius: 8px; font-weight: 600;">Node.js</span>
                    <span class="badge bg-light text-secondary border px-3 py-2" style="border-radius: 8px; font-weight: 600;">Tailwind CSS</span>
                    <span class="badge bg-light text-secondary border px-3 py-2" style="border-radius: 8px; font-weight: 600;">AWS</span>
                }
            </div>
        </div>

        <!-- Emergency Contacts -->
        <div class="ess-card premium-shadow">
            <div class="d-flex align-items-center gap-2 mb-4">
                <i class="fas fa-users text-accent" style="color: #10b981;"></i>
                <h6 class="mb-0 fw-800">Emergency Contacts</h6>
            </div>
            <div class="d-flex flex-column gap-4">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="fw-800" style="font-size: 14px;">Elena Johnson</div>
                        <div class="text-secondary small"><i class="fas fa-phone me-2"></i>+1 (555) 987-6543</div>
                    </div>
                    <span class="badge bg-light text-secondary small text-uppercase" style="font-size: 10px;">SPOUSE</span>
                </div>
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="fw-800" style="font-size: 14px;">Marcus Johnson</div>
                        <div class="text-secondary small"><i class="fas fa-phone me-2"></i>+1 (555) 555-0199</div>
                    </div>
                    <span class="badge bg-light text-secondary small text-uppercase" style="font-size: 10px;">BROTHER</span>
                </div>
            </div>
        </div>

        <!-- Location Map Placeholder -->
        <div class="ess-card p-0 overflow-hidden premium-shadow" style="height: 180px;">
            <img src="https://maps.googleapis.com/maps/api/staticmap?center=40.7128,-74.0060&zoom=13&size=400x200&sensor=false&markers=color:green%7C40.7128,-74.0060" class="w-100 h-100 object-fit-cover">
            <div class="position-absolute bottom-0 w-100 p-2 glass-card text-center" style="font-size: 11px; font-weight: 700;">Primary Office Location</div>
        </div>
    </div>
</div>
