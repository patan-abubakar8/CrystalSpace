@model Organize4u.Core.Models.DashboardStats

@{
    ViewData["Title"] = "HR Dashboard";
    Layout = "_HRLayout";
}

<header class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h1 class="h3 mb-1" style="font-weight: 700;">HR Dashboard</h1>
        <p class="text-secondary mb-0">Overview of your workforce and pending tasks</p>
    </div>
    <div class="d-flex gap-3">
        <button class="btn btn-outline-premium">
            <i class="fas fa-download me-2"></i> Export Reports
        </button>
        <a asp-action="Create" class="btn btn-premium">
            <i class="fas fa-plus me-2"></i> New Request
        </a>
    </div>
</header>

        <!-- Stats Grid -->
        <div class="row mb-5">
            <div class="col-md-3">
                <div class="hr-card stat-card">
                    <div class="stat-header">
                        <div class="stat-icon" style="color: var(--accent-green);">
                            <i class="fas fa-id-card"></i>
                        </div>
                        <div class="stat-change up">+@Model.TotalEmployeesChange%</div>
                    </div>
                    <div class="text-secondary small">Total Employees</div>
                    <div class="stat-value">@Model.TotalEmployees.ToString("N0")</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="hr-card stat-card">
                    <div class="stat-header">
                        <div class="stat-icon" style="color: #f57c00;">
                            <i class="fas fa-calendar-day"></i>
                        </div>
                        <div class="stat-change down">@Model.EmployeesOnLeaveChange%</div>
                    </div>
                    <div class="text-secondary small">Employees On Leave</div>
                    <div class="stat-value">@Model.EmployeesOnLeaveCount</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="hr-card stat-card">
                    <div class="stat-header">
                        <div class="stat-icon" style="color: #1565c0;">
                            <i class="fas fa-tasks"></i>
                        </div>
                        <div class="stat-change up">+@Model.PendingLeavesChange%</div>
                    </div>
                    <div class="text-secondary small">Pending Requests</div>
                    <div class="stat-value">@Model.PendingLeavesCount</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="hr-card stat-card">
                    <div class="stat-header">
                        <div class="stat-icon" style="color: var(--accent-green);">
                            <i class="fas fa-user-plus"></i>
                        </div>
                        <div class="stat-change down">@Model.NewJoineesChange%</div>
                    </div>
                    <div class="text-secondary small">New Joinees</div>
                    <div class="stat-value">@Model.NewJoineesCount</div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Left Column -->
            <div class="col-lg-8">
                <div class="hr-card mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="h6 mb-0" style="font-weight: 700;">Recent Activities</h4>
                        <a href="#" class="text-accent-green small text-decoration-none">View All</a>
                    </div>
                    <div class="activity-feed">
                        @foreach (var activity in Model.RecentActivities)
                        {
                            <div class="activity-item">
                                <img src="@activity.UserAvatarUrl" class="avatar" alt="Avatar">
                                <div class="flex-grow-1">
                                    <strong>@activity.UserName</strong> @activity.Action
                                    <div class="small text-secondary mt-1">@(activity.Timestamp.Contains("AM") || activity.Timestamp.Contains("PM") ? activity.Timestamp : "Just now")</div>
                                </div>
                                <div class="small text-secondary">@activity.Timestamp</div>
                            </div>
                        }
                    </div>
                </div>

                <div class="hr-card">
                    <div class="mb-4">
                        <h4 class="h6 mb-0" style="font-weight: 700;">Pending Leave Requests</h4>
                    </div>
                    <table class="table-premium">
                        <thead>
                            <tr>
                                <th>Employee</th>
                                <th>Type</th>
                                <th>Dates</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var leave in Model.PendingLeaves.Take(3))
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="https://ui-avatars.com/api/?name=@leave.Employee?.FirstName+@leave.Employee?.LastName" class="avatar" style="width: 32px; height: 32px;" alt="">
                                            <div>
                                                <div style="font-weight: 600;">@leave.Employee?.FirstName @leave.Employee?.LastName</div>
                                                <div class="small text-secondary">@leave.Employee?.Designation</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge-premium badge-annual">@leave.LeaveType?.Name</span>
                                    </td>
                                    <td>
                                        <div class="small">@leave.StartDate.ToString("MMM dd") - @leave.EndDate.ToString("MMM dd")</div>
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <button class="btn btn-sm" style="color: var(--accent-green);"><i class="fas fa-check-circle"></i></button>
                                            <button class="btn btn-sm text-danger"><i class="fas fa-times-circle"></i></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Right Column -->
            <div class="col-lg-4">
                <div class="hr-card mb-4">
                    <h4 class="h6 mb-4" style="font-weight: 700;">Quick Actions</h4>
                    <div class="d-flex flex-column gap-3">
                        <a asp-action="Create" class="hr-card mb-0 d-flex align-items-center gap-3 text-decoration-none p-3" style="background: var(--accent-green-light);">
                            <div class="stat-icon" style="color: var(--accent-green-dark);"><i class="fas fa-user-plus"></i></div>
                            <div>
                                <div style="font-weight: 600; color: var(--text-primary);">Add Employee</div>
                                <div class="small text-secondary">Create a new profile</div>
                            </div>
                        </a>
                        <a asp-action="Salaries" class="hr-card mb-0 d-flex align-items-center gap-3 text-decoration-none p-3" style="background: #fff7e6;">
                            <div class="stat-icon" style="color: #f57c00;"><i class="fas fa-file-invoice-dollar"></i></div>
                            <div>
                                <div style="font-weight: 600; color: var(--text-primary);">Generate Payroll</div>
                                <div class="small text-secondary">Monthly cycle processing</div>
                            </div>
                        </a>
                        <a href="#" class="hr-card mb-0 d-flex align-items-center gap-3 text-decoration-none p-3" style="background: #e8f4ff;">
                            <div class="stat-icon" style="color: #1565c0;"><i class="fas fa-bullhorn"></i></div>
                            <div>
                                <div style="font-weight: 600;">Post Announcement</div>
                                <div class="small text-secondary">Notify entire company</div>
                            </div>
                        </a>
                    </div>
                </div>

                <div class="hr-card">
                    <h4 class="h6 mb-4" style="font-weight: 700;">New Joinees</h4>
                    <div class="activity-feed">
                        @foreach (var joinee in Model.NewJoinees)
                        {
                            <div class="activity-item">
                                <img src="https://ui-avatars.com/api/?name=@joinee.FirstName+@joinee.LastName" class="avatar" alt="">
                                <div class="flex-grow-1">
                                    <div style="font-weight: 600;">@joinee.FirstName @joinee.LastName</div>
                                    <div class="small text-secondary">@joinee.Designation</div>
                                    <div class="small mt-1" style="color: var(--accent-green);">STARTING @joinee.JoiningDate.ToString("MMM dd").ToUpper()</div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="mt-4 text-center">
                        <a href="#" class="text-secondary small text-decoration-none">View Onboarding Pipeline</a>
                    </div>
                </div>
            </div>
        </div>
