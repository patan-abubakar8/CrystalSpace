<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HR Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/hr-dashboard.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="hr-sidebar">
        <div class="hr-logo">
            <div class="hr-logo-icon">
                <i class="fas fa-th-large"></i>
            </div>
            <div>
                <div style="font-weight: 700; color: var(--text-primary);">HR Portal</div>
                <div style="font-size: 11px; color: var(--text-secondary);">Admin Console</div>
            </div>
        </div>

        <nav>
            <a asp-action="Index" class="hr-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                <i class="fas fa-grip-vertical"></i> Dashboard
            </a>
            <a asp-action="Employees" class="hr-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Employees" ? "active" : "")">
                <i class="fas fa-users"></i> Employees
            </a>
            <a asp-action="Leaves" class="hr-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Leaves" ? "active" : "")">
                <i class="fas fa-calendar-alt"></i> Leave Management
            </a>
            <a asp-action="Salaries" class="hr-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Salaries" ? "active" : "")">
                <i class="fas fa-wallet"></i> Payroll
            </a>
            <a asp-action="Reports" class="hr-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Reports" ? "active" : "")">
                <i class="fas fa-chart-bar"></i> Reports
            </a>
            <a asp-action="Documents" class="hr-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Documents" ? "active" : "")">
                <i class="fas fa-file-alt"></i> Documents
            </a>
        </nav>

@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

        <div class="user-profile-footer">
            @if (SignInManager.IsSignedIn(User))
            {
                <img src="https://ui-avatars.com/api/?name=@User.Identity?.Name&background=0D8ABC&color=fff" class="avatar" alt="User">
                <div class="flex-grow-1">
                    <div style="font-size: 14px; font-weight: 600; color: var(--text-primary);">@User.Identity?.Name</div>
                    <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                        <button type="submit" class="btn btn-link p-0" style="font-size: 11px; text-decoration: none; color: var(--text-secondary);">Logout</button>
                    </form>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-2 w-100">
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-sm btn-outline-premium">Login</a>
                </div>
            }
        </div>
    </div>

    <div class="hr-main-content">
        @RenderBody()
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
