@model Organize4u.Core.Models.Employee

<div class="hr-card mb-4">
    <h5 class="mb-4" style="font-weight: 700;"><i class="fas fa-user-tag me-2 text-accent-green"></i> Other Details</h5>
    <div class="row row-cols-2 g-4">
        <div>
            <div class="text-secondary small mb-1">NATIONALITY</div>
            <div style="font-weight: 600;">@(Model.PersonalDetail?.Nationality ?? "Not Specified")</div>
        </div>
        <div>
            <div class="text-secondary small mb-1">MARITAL STATUS</div>
            <div style="font-weight: 600;">@(Model.PersonalDetail?.MaritalStatus ?? "Not Specified")</div>
        </div>
        <div>
            <div class="text-secondary small mb-1">RESIDENTIAL ADDRESS</div>
            <div style="font-weight: 600;">@(Model.PersonalDetail?.Address ?? "Not Provided")</div>
        </div>
        <div>
            <div class="text-secondary small mb-1">CITY</div>
            <div style="font-weight: 600;">@(Model.PersonalDetail?.City ?? "Not Specified")</div>
        </div>
        <div>
            <div class="text-secondary small mb-1">COUNTRY</div>
            <div style="font-weight: 600;">@(Model.PersonalDetail?.Country ?? "Not Specified")</div>
        </div>
        <div>
            <div class="text-secondary small mb-1">ZIP/POSTAL CODE</div>
            <div style="font-weight: 600;">@(Model.PersonalDetail?.ZIPCode ?? "Not Specified")</div>
        </div>
        @if (!string.IsNullOrEmpty(Model.Skills))
        {
            <div class="col-12">
                <div class="text-secondary small mb-1">SKILLS & EXPERTISE</div>
                <div class="d-flex flex-wrap gap-2 mt-2">
                    @foreach (var skill in Model.Skills.Split(','))
                    {
                        <span class="skill-tag">@skill.Trim()</span>
                    }
                </div>
            </div>
        }
    </div>
</div>
