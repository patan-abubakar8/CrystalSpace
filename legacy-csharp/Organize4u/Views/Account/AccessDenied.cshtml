@{
    ViewData["Title"] = "Access Denied";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-body p-5">
                    <div class="text-center">
                        <i class="bi bi-shield-exclamation text-danger" style="font-size: 4rem;"></i>
                        <h2 class="mt-3">Access Denied</h2>
                        <p class="text-muted">You don't have permission to access this resource.</p>
                    </div>
                    
                    @if (ViewData["ReturnUrl"] != null)
                    {
                        <p class="small text-muted text-center">Attempted to access: <code>@ViewData["ReturnUrl"]</code></p>
                    }
                    
                    <div class="mt-4 p-3 bg-light rounded">
                        <h5>Debug Information:</h5>
                        <ul class="list-unstyled small">
                            <li><strong>Authenticated:</strong> @ViewData["IsAuthenticated"]</li>
                            <li><strong>Username:</strong> @ViewData["UserName"]</li>
                            <li><strong>Roles:</strong> @ViewData["Roles"]</li>
                            <li><strong>All Claims:</strong> <code class="small">@ViewData["AllClaims"]</code></li>
                        </ul>
                    </div>
                    
                    <div class="mt-4 text-center">
                        <a asp-action="Login" asp-controller="Account" class="btn btn-primary">
                            <i class="bi bi-box-arrow-in-right"></i> Back to Login
                        </a>
                        <a asp-action="Logout" asp-controller="Account" class="btn btn-secondary ms-2">
                            <i class="bi bi-box-arrow-right"></i> Logout
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
